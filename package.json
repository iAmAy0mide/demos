{
  "name": "demos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint app src scripts --cache --cache-location .cache/eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:metadata": "node scripts/check-metadata.mjs",
    "report:large-files": "node --experimental-strip-types scripts/report-large-files.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:tokens && npm run check:lagos-time && npm run check:metadata && npm run check:contact && npm run check:attribution",
    "check:full": "npm run check && npm run check:brief-message && npm run check:anatomy && npm run check:demo-links && npm run check:menu && npm run check:overflow && npm run check:pill-clearance && npm run build && npm run smoke:routes && npm run check:seo && npm run e2e",
    "prepare": "git config core.hooksPath .githooks",
    "screenshots": "node --experimental-strip-types scripts/screenshots.ts",
    "logo": "node --experimental-strip-types scripts/generate-logo-assets.ts",
    "previews": "node --experimental-strip-types scripts/generate-previews.ts",
    "og": "node --experimental-strip-types scripts/generate-og.ts",
    "smoke:routes": "node --experimental-strip-types scripts/smoke-routes.ts",
    "check:tokens": "node scripts/check-demo-tokens.mjs",
    "check:fieldhand-tokens": "node scripts/check-demo-tokens.mjs",
    "check:lagos-time": "node scripts/check-lagos-time.mjs",
    "check:fieldhand-slots": "node --experimental-strip-types scripts/check-fieldhand-slots.ts",
    "check:rentbook-seed": "node --experimental-strip-types scripts/check-rentbook-seed.ts",
    "check:csv": "node --experimental-strip-types scripts/check-csv.ts",
    "check:ledger": "node --experimental-strip-types scripts/check-ledger.ts",
    "check:building-layout": "node --experimental-strip-types scripts/check-building-layout.ts",
    "check:contact": "node --experimental-strip-types scripts/check-contact.ts",
    "check:attribution": "node --experimental-strip-types scripts/check-attribution.ts",
    "check:brief-message": "node --experimental-strip-types scripts/check-brief-message.ts",
    "check:anatomy": "node --experimental-strip-types scripts/check-anatomy.ts",
    "check:demo-links": "node --experimental-strip-types scripts/check-demo-links.ts",
    "check:menu": "node --experimental-strip-types scripts/check-menu.ts",
    "check:seo": "node --experimental-strip-types scripts/check-seo.ts",
    "check:overflow": "node --experimental-strip-types scripts/check-overflow.ts",
    "check:pill-clearance": "node --experimental-strip-types scripts/check-pill-clearance.ts",
    "audit:lighthouse": "node --experimental-strip-types scripts/audit-lighthouse.ts",
    "audit:a11y": "node --experimental-strip-types scripts/audit-a11y.ts",
    "e2e:fieldhand": "node --experimental-strip-types scripts/e2e-fieldhand.ts",
    "e2e:rentbook": "node --experimental-strip-types scripts/e2e-rentbook.ts",
    "e2e": "npm run e2e:fieldhand && npm run e2e:rentbook"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chrome-launcher": "1.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "lighthouse": "13.5.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
